{
    "name": "laravel/laravel",
    "type": "project",
    "description": " Web Application for Creating content for the Dianoia mobile app.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^3.5",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/fortify": "^1.7",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.5",
        "opcodesio/log-viewer": "^3.14",
        "scify/laravel-cookie-guard": "^5.1.0",
        "sentry/sentry-laravel": "^4.7.1",
        "spatie/laravel-sitemap": "^7.3",
        "symfony/http-client": "^6.2",
        "symfony/mailgun-mailer": "^6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.13.0",
        "laravel/pint": "^1.8",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Utils/UrlHelpers.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=cookies-consent-public --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install",
            "@php -r \"require 'vendor/autoload.php'; empty(Dotenv\\Dotenv::parse(file_get_contents('.env'))['APP_KEY'] ?? null) && exit(pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan key:generate --ansi', 'w')));\"",
            "@php -r \"is_link('public/storage') || exit(pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan storage:link --ansi', 'w')));\"",
            "@php -r \"file_exists('node_modules/.package-lock.json') && filemtime('node_modules/.package-lock.json') >= filemtime('package-lock.json') || exit(pclose(popen('npm ci', 'w')));\"",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php artisan config:clear --ansi",
            "@php artisan test --coverage --coverage-html=coverage"
        ],
        "lint:check": [
            "pint --test",
            "phpstan analyse --no-progress",
            "npm run lint"
        ],
        "lint:fix": [
            "pint",
            "npm run lint:fix",
            "phpstan analyse --no-progress"
        ]
    },
    "scripts-descriptions": {
        "setup": "Create .env if missing, install PHP dependencies and (when package-lock.json changed) npm dependencies, generate APP_KEY if empty, link storage and build the frontend.",
        "test": "Run the test suite (SQLite in memory).",
        "test:coverage": "Run the test suite with a coverage summary and an HTML report in coverage/ (needs PCOV or Xdebug).",
        "lint:check": "Check PHP style (Pint), run static analysis (PHPStan) and lint JavaScript (ESLint) without changing files.",
        "lint:fix": "Fix PHP style (Pint) and JavaScript (ESLint --fix), then report what PHPStan still finds."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
